# PostgreSQL connection (local data centre)
# User: nifty_app, Password: nifty_app_pw, Database: Centralized_Index_Option_Data, Host: localhost, Port: 5432
DATABASE_URL=postgresql://nifty_app:nifty_app_pw@localhost:5432/Centralized_Index_Option_Data

# Optional: HostITSmart / remote PostgreSQL sync (see Important_commands.md — HostITSmart section).
# Typical: user nifty_app, database nifty_data, Postgres on 127.0.0.1 on the VPS.
# REMOTE_DATABASE_URL=postgresql://nifty_app:YOUR_PASSWORD@103.168.18.35:5432/nifty_data
# Port 5432 is usually blocked from home — enable auto SSH tunnel (uses VPS_HOST / VPS_SSH_PORT):
# REMOTE_PG_SSH_TUNNEL=1
# REMOTE_PG_TUNNEL_LOCAL_PORT=5433
# REMOTE_PG_TUNNEL_TARGET=127.0.0.1:5432
# Long range repair: retries per hour-chunk if SSH/Postgres drops (default 8)
# REMOTE_PG_CHUNK_RETRIES=8
# Local upsert batch size for ltp_ticks (default 3000 rows per INSERT; max ~4500 — PG param limit)
# LTP_UPSERT_BATCH_SIZE=3000
# Set to 1 to log full-table COUNT(*) before/after each insert_records call (slow on large DBs)
# LTP_UPSERT_LOG_TABLE_COUNT=0
# TCP keepalives on DB connection (default on). Set REMOTE_PG_TCP_KEEPALIVE=0 to disable.
# Alias: SYNC_SOURCE_DATABASE_URL=

# Optional: VPS / SSH + SQLite sync (see services/ssh_vps.py)
# Hostinger (default port 22):
# VPS_HOST=31.97.233.93
# HostITSmart (correct host is 103.168.18.35, not 103.168.233.93):
# VPS_HOST=103.168.18.35
# VPS_SSH_PORT=7576
# VPS_USER=root
# VPS_DB_PATH=/opt/nifty-data-collector/nifty_local.db
# SSH_KEY_PATH=~/.ssh/nifty_server_key

# Optional: For local collector writing to PostgreSQL
# DB_URL=postgresql://nifty_app:nifty_app_pw@localhost:5432/Centralized_Index_Option_Data
